# Copy to .env (never commit .env). On Streamlit Cloud put these in App settings → Secrets.
APP_ENV=development                 # development | production
DATABASE_URL=postgresql+psycopg2://medishare:CHANGE_ME@localhost:5432/medishare
# Leave DATABASE_URL unset for a local SQLite dev database (medishare_dev.db)

AUTH_MODE=oidc                      # oidc (Google via st.login) | dev (local demo login; refused in production)
OIDC_PROVIDER=google
SESSION_TIMEOUT_MINUTES=60
BOOTSTRAP_SUPER_ADMIN_EMAIL=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_EXTERNAL_PROCESSING_ENABLED=true # set false to keep all images on-platform (OCR only)

GOOGLE_MAPS_API_KEY=                # optional – OpenStreetMap is used by default

STORAGE_ENDPOINT=                   # S3-compatible endpoint (blank = AWS)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOCAL_STORAGE_DIR=.private_storage  # dev only – never permanent storage on Streamlit Cloud

EMAIL_PROVIDER_API_KEY=
MAX_UPLOAD_MB=8
TESSERACT_CMD=                      # optional explicit path to tesseract
